# Local dev (SQLite, zero setup):
DATABASE_URL="file:./dev.db"

# Production (Postgres — Neon or Supabase free tier), after switching the
# datasource provider in prisma/schema.prisma to "postgresql":
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
#
# When DATABASE_URL points at a transaction-mode pooler (Supabase Supavisor
# port 6543 with pgbouncer=true), also set DIRECT_URL for Prisma Migrate /
# db push / introspection. Use the SAME pooler host on port 5432 (session
# mode) — NOT db.<ref>.supabase.co, which is IPv6-only and fails with P1001
# on most networks.
# DIRECT_URL="postgresql://postgres.<ref>:password@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Connection pool size for THIS process (src/lib/prisma.ts applies these to
# DATABASE_URL unless it already sets them). Prisma's built-in default is
# only num_cpus*2+1 (~5), so a page that runs several queries at once
# starves the pool and later requests time out. Default here is 20.
#   - Raise it if requests still queue/time out under light load.
#   - On Supabase, ALSO raise the pooler "Pool Size" for this user under
#     Project → Database → Connection pooling (default 15) to at least
#     connection_limit × number of running instances — otherwise the extra
#     slots just wait at Supavisor.
#   - On heavily-parallel serverless (many cold instances), prefer a SMALL
#     value (e.g. 1–3) and a large Supabase pool size instead.
# DATABASE_CONNECTION_LIMIT="20"
# DATABASE_POOL_TIMEOUT="20"

# 32-byte hex key for AES-256-GCM encryption of delivered credentials/keys.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-chars"

# Signing secret for admin session JWTs.
SESSION_SECRET="replace-with-a-long-random-string"

# Gmail SMTP — used to send forgot-password codes (src/lib/mailer.ts).
# 1. Turn on 2-Step Verification on the Gmail account you want to send from:
#    https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (App name can be anything, e.g. "Gamefy"). Google gives you a 16-char
#    code — that's GMAIL_APP_PASSWORD, NOT your real Gmail login password.
# 3. GMAIL_USER is the full Gmail address you generated the App Password for.
GMAIL_USER="youraddress@gmail.com"
GMAIL_APP_PASSWORD="replace-with-16-char-app-password"

# Vercel Blob — where uploaded images go (admin product/category/collection
# photos, checkout payment-proof screenshots). A serverless deployment's
# filesystem is read-only, so these can't be saved to public/uploads.
# On Vercel: Project → Storage → Create Database → Blob. This env var is
# then auto-injected for you in Production/Preview — no copy-paste needed
# there. For local dev, copy the token it shows you into here.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx"
