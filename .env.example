# ===========================================================================
# Database (Supabase Postgres)
# ===========================================================================
# DATABASE_URL  -> runtime queries. MUST be the TRANSACTION pooler:
#   host  ...pooler.supabase.com  PORT 6543   query  ?pgbouncer=true
#   Transaction mode hands the connection back after each statement, so a
#   small pool serves many serverless instances.
#
# DIRECT_URL    -> migrations / db push / introspection only. The SESSION
#   pooler: same host, PORT 5432. (NOT db.<ref>.supabase.co — IPv6-only,
#   fails with P1001 on most networks.)
#
# Get both from: Supabase dashboard -> Project Settings -> Database ->
# "Connection string" -> Transaction (6543) and Session (5432) tabs.
#
# connection_limit=1 : each serverless instance holds ONE connection and
#   lets the pooler fan out. A single long-lived Node server may raise it.
#
# TROUBLESHOOTING "FATAL: max clients reached in session mode /
# EMAXCONNSESSION, pool_size: 15": DATABASE_URL is on :5432 (session) — move
# it to :6543 (transaction). Optionally also raise Pool Size under
# Project Settings -> Database -> Connection pooling.

DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Overrides for src/lib/prisma.ts (applied to DATABASE_URL only if absent
# from the URL itself). Default connection_limit is 1 (serverless).
# DATABASE_CONNECTION_LIMIT="1"
# DATABASE_POOL_TIMEOUT="20"

# 32-byte hex key for AES-256-GCM encryption of delivered credentials/keys.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-chars"

# Signing secret for admin session JWTs.
SESSION_SECRET="replace-with-a-long-random-string"

# Gmail SMTP — used to send forgot-password codes (src/lib/mailer.ts).
# 1. Turn on 2-Step Verification on the Gmail account you want to send from:
#    https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (App name can be anything, e.g. "Gamefy"). Google gives you a 16-char
#    code — that's GMAIL_APP_PASSWORD, NOT your real Gmail login password.
# 3. GMAIL_USER is the full Gmail address you generated the App Password for.
GMAIL_USER="youraddress@gmail.com"
GMAIL_APP_PASSWORD="replace-with-16-char-app-password"

# Vercel Blob — where uploaded images go (admin product/category/collection
# photos, checkout payment-proof screenshots). A serverless deployment's
# filesystem is read-only, so these can't be saved to public/uploads.
# On Vercel: Project → Storage → Create Database → Blob. This env var is
# then auto-injected for you in Production/Preview — no copy-paste needed
# there. For local dev, copy the token it shows you into here.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx"
